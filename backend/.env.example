# StreamForge Configuration
# Copy this file to .env and adjust values for your environment.

# ──────────────────────────────────────────────
# Application
# ──────────────────────────────────────────────
STREAMFORGE_APP_NAME=StreamForge API
STREAMFORGE_VERSION=0.1.0
STREAMFORGE_DEBUG=true

# ──────────────────────────────────────────────
# State Backend
# ──────────────────────────────────────────────
# Options: in_memory (default) | rocksdb | kafka (future)
STREAMFORGE_STATE_BACKEND=in_memory

# ──────────────────────────────────────────────
# Kafka (future integration)
# ──────────────────────────────────────────────
# STREAMFORGE_KAFKA_BOOTSTRAP_SERVERS=localhost:9092
# STREAMFORGE_KAFKA_TELEMETRY_TOPIC=streamforge.telemetry
# STREAMFORGE_KAFKA_CONSUMER_GROUP=streamforge-api

# ──────────────────────────────────────────────
# RocksDB (future integration)
# ──────────────────────────────────────────────
# STREAMFORGE_ROCKSDB_PATH=/var/lib/streamforge/state

# ──────────────────────────────────────────────
# Windowing
# ──────────────────────────────────────────────
STREAMFORGE_WINDOW_SIZE_SECONDS=300

# ──────────────────────────────────────────────
# API Server
# ──────────────────────────────────────────────
STREAMFORGE_HOST=0.0.0.0
STREAMFORGE_PORT=8000
